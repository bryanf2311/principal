# Copy to .env (already gitignored by the repo root .gitignore) and fill in.
# Load it however you run this process — e.g. `node --env-file=.env server.mjs`
# (Node 20.6+) or your process manager's env-file support.

PORT=8787

# Admin SDK credentials — same service account precedent as
# principal-app/scripts/seed.mjs. Point this at a real key file.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json

# Shared secret the Teaching/Grading agents send as
# X-Principal-Ingest-Key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PRINCIPAL_INGEST_KEY=

# Comma-separated list of origins allowed to call /v1/webhooks/* from a
# browser — your deployed Netlify URL, plus http://localhost:PORT for
# local dev if you test against a local dashboard build.
CORS_ORIGIN=https://your-site.netlify.app

# openclaw-native is commonly a shell alias, not a real PATH binary —
# point these at the real thing. See scripts/openclaw-pair-device.mjs
# for how these two get resolved the same way.
OPENCLAW_BIN=/home/ubuntu/.npm-global/bin/openclaw
OPENCLAW_HOME_OVERRIDE=/home/ubuntu/.openclaw-native

# The agent ids deliverToAgent() sends --to. Whatever your Teaching and
# Grading agent personas are actually named/addressed as in OpenClaw.
TEACHING_AGENT_ID=
GRADING_AGENT_ID=
