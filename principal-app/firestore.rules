rules_version = '2';

/* ============================================================
   Principal — Firestore security rules
   ------------------------------------------------------------
   student : reads course content, sessions, gap reports, quizzes,
             homework; writes only its own quiz attempts and
             self-assessments, and may flip homework status/completedAt
   teacher : reads everything above; creates and writes its own
             courses, lessons, materials, milestones, sessions,
             quizzes, gap reports and homework
   admin   : full read/write

   An agent teacher provisions itself (see claimedCurrentSetupKey below)
   using a setup key only the admin controls — config/setupKey. That key
   grants role:"teacher" and nothing else; it can never be used to become
   an admin or a student, and it never grants access to another
   teacher's data.

   Deploy with:  firebase deploy --only firestore:rules
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return hasProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    function isAdmin()   { return role() == 'admin'; }
    function isTeacher() { return role() == 'teacher'; }
    function isStudent() { return role() == 'student'; }

    /* Bootstrap allowlist: the very first admin has to create its own profile,
       because no admin exists yet to create it. Only these email addresses may
       do that, and only for their own document. Keep this list in sync with
       BOOTSTRAP_ADMIN_EMAILS in js/firebase-config.js, and trim it once the
       admin accounts exist. */
    function isBootstrapAdmin() {
      return signedIn() && request.auth.token.email in [
        'bryanf2311@gmail.com'
      ];
    }

    function ownsCourse(courseId) {
      return isTeacher()
        && get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid;
    }

    /* An agent proves it holds the current setup key by first staking a
       claims/{uid} doc containing it (anyone may create their own claim —
       see below), then this compares that claim to the admin-controlled
       value at config/setupKey. get() reads inside rules are not subject to
       the target document's own rules, so this works even though both
       config/setupKey and other users' claims stay unreadable to a caller
       that doesn't already own them. */
    function claimedCurrentSetupKey() {
      return exists(/databases/$(database)/documents/claims/$(request.auth.uid))
        && exists(/databases/$(database)/documents/config/setupKey)
        && get(/databases/$(database)/documents/claims/$(request.auth.uid)).data.setupKey
           == get(/databases/$(database)/documents/config/setupKey).data.value;
    }

    /* --------------------------------------------------------- config */
    match /config/{doc} {
      // Never readable directly by a non-admin: agents only ever compare
      // against it indirectly through claimedCurrentSetupKey() above.
      allow read, write: if isAdmin();
    }

    /* -------------------------------------------------------- claims */
    match /claims/{uid} {
      // Anyone may stake a claim under their own uid — this alone grants
      // nothing; it only becomes useful if its setupKey field happens to
      // match config/setupKey when a users/{uid} create is attempted.
      allow create: if signedIn() && request.auth.uid == uid;
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    /* ------------------------------------------------------------ users */
    match /users/{uid} {
      // Own profile always; teachers and admins may browse the roster.
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin() || isTeacher());
      allow list: if isAdmin() || isTeacher();

      // Admins provision everyone else. A signed-in user may NOT create its own
      // profile — otherwise anyone who can sign in could hand themselves
      // role: "admin". Two narrow exceptions:
      //  - the bootstrap allowlist above, for the very first admin account;
      //  - an agent that holds the current setup key may create ONLY its own
      //    teacher profile (never student or admin) — this is how an agent
      //    provisions itself without any human touching the dashboard.
      allow create: if isAdmin()
        || (isBootstrapAdmin() && request.auth.uid == uid)
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.role == 'teacher'
            && claimedCurrentSetupKey());

      // Users may edit their own profile (including rotating their API key)
      // but may not promote themselves or change their slot.
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.teacherSlot == resource.data.teacherSlot);

      allow delete: if isAdmin();
    }

    /* ---------------------------------------------------------- courses */
    match /courses/{courseId} {
      allow read: if signedIn();
      // A teacher may create a course that names itself as the teacher —
      // this is how an agent sets up its own class after provisioning
      // itself. It can never create a course for someone else.
      allow create: if isAdmin()
        || (isTeacher() && request.resource.data.teacherId == request.auth.uid);
      allow delete: if isAdmin();
      allow update: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);

      match /lessons/{lessonId} {
        allow read: if signedIn();
        allow write: if isAdmin() || ownsCourse(courseId);

        match /materials/{materialId} {
          allow read: if signedIn();
          allow write: if isAdmin() || ownsCourse(courseId);
        }
      }

      match /milestones/{milestoneId} {
        allow read: if signedIn();
        allow write: if isAdmin() || ownsCourse(courseId);
      }
    }

    /* --------------------------------------------------------- sessions */
    match /sessions/{sessionId} {
      allow read: if signedIn();
      allow create: if isAdmin() || ownsCourse(request.resource.data.courseId);
      allow update: if isAdmin() || ownsCourse(resource.data.courseId);
      allow delete: if isAdmin();
    }

    /* ------------------------------------------------------ gapReports */
    match /gapReports/{reportId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (isTeacher() && request.resource.data.teacherId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    /* --------------------------------------------------------- homework */
    match /homework/{homeworkId} {
      allow read: if signedIn();
      allow create: if isAdmin() || ownsCourse(request.resource.data.courseId);
      allow update: if isAdmin() || ownsCourse(resource.data.courseId)
        // The student may only flip status/completedAt to mark it done or
        // undone — everything about what was assigned is the teacher's call.
        || (isStudent() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt']));
      allow delete: if isAdmin() || ownsCourse(resource.data.courseId);
    }

    /* --------------------------------------------------------- quizzes */
    match /quizzes/{quizId} {
      allow read: if signedIn();
      allow create: if isAdmin() || ownsCourse(request.resource.data.courseId);
      allow update, delete: if isAdmin() || ownsCourse(resource.data.courseId);
    }

    /* ---------------------------------------------------- quizAttempts */
    match /quizAttempts/{attemptId} {
      // Students may only read their own attempts, and their queries are
      // filtered by userId so the list operation stays verifiable.
      allow get, list: if isAdmin() || isTeacher()
        || (isStudent() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        || (isStudent() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    /* ----------------------------------------------- studentAssessments */
    match /studentAssessments/{assessmentId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (isStudent() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    /* --------------------------------------------------------- exams */
    /* Session-linked, agent-graded — pushed in by principal-api via the
       Admin SDK, which bypasses these rules entirely by design. The
       `write: if false` here is documentation of that intent, not
       something enforced against the server. */
    match /exams/{examId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /examAttempts/{attemptId} {
      allow get, list: if isAdmin() || isTeacher()
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow write: if false;
    }

    /* A student's own answers, before the Grading agent has graded them.
       Unlike exams/examAttempts, this one IS client-writable — a student
       has to be able to submit their own answers directly. Read-only for
       everyone else's, same as quizAttempts. */
    match /examSubmissions/{submissionId} {
      allow get, list: if isAdmin() || isTeacher()
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin()
        || (isStudent() && request.resource.data.studentId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    /* Anything not matched above is denied by default. */
  }
}
